# FieldCheck API — build-time API base URL override.
#
# Normally you leave this unset. With no value, the app calls the API on the
# same origin it was loaded from, which is what a phone on the LAN needs.
#
# The v1 build hardcoded http://127.0.0.1:8000 in config.js. On a handset
# 127.0.0.1 is the handset itself, so every request failed and the app looked
# offline. A loopback URL is also rejected at runtime when the page is not
# itself on loopback.
#
# Set this only for a fixed API host, for example:
#   VITE_DTB_API_URL=https://api.example.com
VITE_DTB_API_URL=

# Cross-origin browser access for the API, read by backend/main.py at startup.
# Comma-separated explicit origins. Unset means no cross-origin access.
#   DTB_ALLOWED_ORIGINS=https://fieldcheck.example.com
DTB_ALLOWED_ORIGINS=
